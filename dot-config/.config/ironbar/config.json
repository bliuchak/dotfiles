{
  "position": "top",
  "height": 30,
  "anchor_to_edges": true,
  "exclusive_zone": true,
  "start": [
    {
      "type": "workspaces",
      "all_monitors": false
    }
  ],
  "center": [],
  "end": [
    {
      "type": "label",
      "label": "#weather"
    },
    {
      "type": "label",
      "label": "󰖩 #wifi_ssid"
    },
    {
      "format": [
        " {cpu_percent}%",
        " {memory_percent}%"
      ],
      "interval": {
        "cpu": 5,
        "memory": 5
      },
      "type": "sys_info"
    },
    {
      "type": "battery",
      "format": "{percentage}%",
      "icon_size": 14,
      "thresholds": {
        "warning": 20,
        "critical": 5
      }
    },
    {
      "type": "clock",
      "format": "%d/%m/%Y %H:%M:%S"
    }
  ]
}
